{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/zeroshiki/schemas/conformance-assessment-record.schema.json",
  "title": "Conformance Assessment Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "assessment_id",
    "profile_version",
    "chain_id",
    "chain_root",
    "agent_id",
    "authority_domain_id",
    "assessed_at",
    "verifier",
    "scope",
    "checks",
    "findings",
    "result"
  ],
  "properties": {
    "schema_version": {"const": "0.5.0"},
    "record_type": {"const": "conformance_assessment_record"},
    "assessment_id": {"type": "string", "pattern": "^conformance-assessment:[A-Za-z0-9._:-]+$"},
    "profile_version": {"const": "0.5.0"},
    "chain_id": {"type": "string", "pattern": "^authority-evidence-chain:[A-Za-z0-9._:-]+$"},
    "chain_root": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "agent_id": {"type": "string", "minLength": 1},
    "authority_domain_id": {"type": "string", "pattern": "^authority-domain:[A-Za-z0-9._:-]+$"},
    "assessed_at": {"type": "string", "format": "date-time"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_id", "verifier_type", "independent_from_agent", "implementation_digest"],
      "properties": {
        "verifier_id": {"type": "string", "minLength": 1},
        "verifier_type": {"type": "string", "enum": ["independent_service", "external_auditor", "conformance_suite"]},
        "independent_from_agent": {"const": true},
        "implementation_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_count", "record_types"],
      "properties": {
        "entry_count": {"type": "integer", "minimum": 1},
        "record_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas_valid",
        "identifiers_unique",
        "record_digests_match",
        "chain_links_valid",
        "timestamps_monotonic",
        "bindings_complete",
        "authorization_precedes_action",
        "token_single_use",
        "revocation_enforced",
        "closure_complete",
        "evidence_independent"
      ],
      "properties": {
        "schemas_valid": {"type": "boolean"},
        "identifiers_unique": {"type": "boolean"},
        "record_digests_match": {"type": "boolean"},
        "chain_links_valid": {"type": "boolean"},
        "timestamps_monotonic": {"type": "boolean"},
        "bindings_complete": {"type": "boolean"},
        "authorization_precedes_action": {"type": "boolean"},
        "token_single_use": {"type": "boolean"},
        "revocation_enforced": {"type": "boolean"},
        "closure_complete": {"type": "boolean"},
        "evidence_independent": {"type": "boolean"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "record_id", "detail"],
        "properties": {
          "severity": {"type": "string", "enum": ["info", "warning", "error", "critical"]},
          "code": {"type": "string", "minLength": 1},
          "record_id": {"type": ["string", "null"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "result": {"type": "string", "enum": ["conformant", "nonconformant", "indeterminate"]}
  }
}
