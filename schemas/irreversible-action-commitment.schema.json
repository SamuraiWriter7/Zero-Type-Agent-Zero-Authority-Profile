{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/zeroshiki/schemas/irreversible-action-commitment.schema.json",
  "title": "Irreversible Action Commitment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "commitment_id",
    "risk_assessment_id",
    "quorum_id",
    "authority_domain_id",
    "agent_id",
    "grant_id",
    "action_digest",
    "prepared_at",
    "not_before",
    "expires_at",
    "idempotency_key",
    "rollback_or_compensation_ref",
    "final_confirmation",
    "checks",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "record_type": {
      "const": "irreversible_action_commitment"
    },
    "commitment_id": {
      "type": "string",
      "pattern": "^action-commitment:[A-Za-z0-9._:-]+$"
    },
    "risk_assessment_id": {
      "type": "string",
      "pattern": "^risk-assessment:[A-Za-z0-9._:-]+$"
    },
    "quorum_id": {
      "type": "string",
      "pattern": "^authorization-quorum:[A-Za-z0-9._:-]+$"
    },
    "authority_domain_id": {
      "type": "string",
      "pattern": "^authority-domain:[A-Za-z0-9._:-]+$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "grant_id": {
      "type": "string",
      "pattern": "^capability-grant:[A-Za-z0-9._:-]+$"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "rollback_or_compensation_ref": {
      "type": "string",
      "minLength": 1
    },
    "final_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmation_id",
        "confirmer_id",
        "role",
        "confirmed_at",
        "action_digest"
      ],
      "properties": {
        "confirmation_id": {
          "type": "string",
          "pattern": "^confirmation:[A-Za-z0-9._:-]+$"
        },
        "confirmer_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "human_origin",
            "domain_owner"
          ]
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "action_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quorum_satisfied",
        "cooling_off_elapsed",
        "action_unchanged",
        "final_human_confirmation",
        "rollback_or_compensation_defined",
        "revocation_clear"
      ],
      "properties": {
        "quorum_satisfied": {
          "type": "boolean"
        },
        "cooling_off_elapsed": {
          "type": "boolean"
        },
        "action_unchanged": {
          "type": "boolean"
        },
        "final_human_confirmation": {
          "type": "boolean"
        },
        "rollback_or_compensation_defined": {
          "type": "boolean"
        },
        "revocation_clear": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "committed",
        "cancelled",
        "expired"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "cancelled",
              "expired"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "reasons"
        ]
      }
    }
  ]
}
