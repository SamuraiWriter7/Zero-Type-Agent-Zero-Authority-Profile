{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/zeroshiki/schemas/authorization-quorum-receipt.schema.json",
  "title": "Authorization Quorum Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "quorum_id",
    "risk_assessment_id",
    "authority_domain_id",
    "agent_id",
    "grant_id",
    "action_digest",
    "assembled_at",
    "policy",
    "approvals",
    "checks",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "record_type": {
      "const": "authorization_quorum_receipt"
    },
    "quorum_id": {
      "type": "string",
      "pattern": "^authorization-quorum:[A-Za-z0-9._:-]+$"
    },
    "risk_assessment_id": {
      "type": "string",
      "pattern": "^risk-assessment:[A-Za-z0-9._:-]+$"
    },
    "authority_domain_id": {
      "type": "string",
      "pattern": "^authority-domain:[A-Za-z0-9._:-]+$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "grant_id": {
      "type": "string",
      "pattern": "^capability-grant:[A-Za-z0-9._:-]+$"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "assembled_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_approvals",
        "required_roles",
        "distinct_approvers_required",
        "agent_self_approval_allowed"
      ],
      "properties": {
        "minimum_approvals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "required_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "human_origin",
              "safety_authority",
              "domain_owner",
              "auditor"
            ]
          }
        },
        "distinct_approvers_required": {
          "const": true
        },
        "agent_self_approval_allowed": {
          "const": false
        }
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approval_id",
          "approver_id",
          "role",
          "decision",
          "approved_at",
          "expires_at",
          "action_digest",
          "conflict_of_interest"
        ],
        "properties": {
          "approval_id": {
            "type": "string",
            "pattern": "^approval:[A-Za-z0-9._:-]+$"
          },
          "approver_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "human_origin",
              "safety_authority",
              "domain_owner",
              "auditor"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "veto"
            ]
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "action_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "conflict_of_interest": {
            "type": "boolean"
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_approvals_met",
        "required_roles_present",
        "distinct_approvers",
        "no_self_approval",
        "no_conflict_of_interest",
        "no_veto",
        "approvals_unexpired",
        "action_digest_consistent"
      ],
      "properties": {
        "minimum_approvals_met": {
          "type": "boolean"
        },
        "required_roles_present": {
          "type": "boolean"
        },
        "distinct_approvers": {
          "type": "boolean"
        },
        "no_self_approval": {
          "type": "boolean"
        },
        "no_conflict_of_interest": {
          "type": "boolean"
        },
        "no_veto": {
          "type": "boolean"
        },
        "approvals_unexpired": {
          "type": "boolean"
        },
        "action_digest_consistent": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "satisfied",
        "pending",
        "denied"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "pending",
              "denied"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "reasons"
        ]
      }
    }
  ]
}
