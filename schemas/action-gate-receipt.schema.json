{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://example.org/zeroshiki/schemas/action-gate-receipt.schema.json",
  "title": "Action Gate Receipt",
  "required": [
    "schema_version",
    "record_type",
    "receipt_id",
    "agent_id",
    "authority_domain_id",
    "grant_id",
    "grant_epoch",
    "observed_revocation_epoch",
    "evaluated_at",
    "valid_until",
    "action_digest",
    "risk_assessment_id",
    "authorization_quorum_id",
    "commitment_id",
    "data_egress_authorization_id",
    "runtime_interlock_id",
    "tool_attestation_id",
    "execution_context_id",
    "requested_action",
    "checks",
    "continuity",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "record_type": {
      "const": "action_gate_receipt"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^action-gate:[A-Za-z0-9._:-]+$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_domain_id": {
      "type": "string",
      "pattern": "^authority-domain:[A-Za-z0-9._:-]+$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^capability-grant:[A-Za-z0-9._:-]+$"
    },
    "grant_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "observed_revocation_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "risk_assessment_id": {
      "type": "string",
      "pattern": "^risk-assessment:[A-Za-z0-9._:-]+$"
    },
    "authorization_quorum_id": {
      "type": "string",
      "pattern": "^authorization-quorum:[A-Za-z0-9._:-]+$"
    },
    "commitment_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^action-commitment:[A-Za-z0-9._:-]+$"
    },
    "requested_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type",
        "target",
        "tool",
        "parameters_digest"
      ],
      "properties": {
        "action_type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "parameters_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_active",
        "grant_epoch_current",
        "revocation_clear",
        "delegation_chain_valid",
        "within_scope",
        "target_allowed",
        "tool_allowed",
        "within_time_window",
        "invocation_budget_available",
        "recorder_available",
        "irreversible_action",
        "human_approval_ref",
        "risk_classified",
        "risk_within_grant",
        "authorization_quorum_satisfied",
        "commitment_satisfied",
        "execution_context_valid",
        "context_bound_to_agent",
        "authority_domain_bound",
        "tool_identity_valid",
        "tool_digest_current",
        "tool_allowed_in_context",
        "runtime_interlock_armed",
        "interlock_fail_closed",
        "data_boundary_satisfied"
      ],
      "properties": {
        "grant_active": {
          "type": "boolean"
        },
        "grant_epoch_current": {
          "type": "boolean"
        },
        "revocation_clear": {
          "type": "boolean"
        },
        "delegation_chain_valid": {
          "type": "boolean"
        },
        "within_scope": {
          "type": "boolean"
        },
        "target_allowed": {
          "type": "boolean"
        },
        "tool_allowed": {
          "type": "boolean"
        },
        "within_time_window": {
          "type": "boolean"
        },
        "invocation_budget_available": {
          "type": "boolean"
        },
        "recorder_available": {
          "type": "boolean"
        },
        "irreversible_action": {
          "type": "boolean"
        },
        "human_approval_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk_classified": {
          "type": "boolean"
        },
        "risk_within_grant": {
          "type": "boolean"
        },
        "authorization_quorum_satisfied": {
          "type": "boolean"
        },
        "commitment_satisfied": {
          "type": "boolean"
        },
        "execution_context_valid": {
          "type": "boolean"
        },
        "context_bound_to_agent": {
          "type": "boolean"
        },
        "authority_domain_bound": {
          "type": "boolean"
        },
        "tool_identity_valid": {
          "type": "boolean"
        },
        "tool_digest_current": {
          "type": "boolean"
        },
        "tool_allowed_in_context": {
          "type": "boolean"
        },
        "runtime_interlock_armed": {
          "type": "boolean"
        },
        "interlock_fail_closed": {
          "type": "boolean"
        },
        "data_boundary_satisfied": {
          "type": "boolean"
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "interval_seconds",
        "max_unchecked_seconds"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "max_unchecked_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "allowed",
        "denied",
        "human_review_required"
      ]
    },
    "execution_token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_id",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "token_id": {
          "type": "string",
          "pattern": "^execution-token:[A-Za-z0-9._:-]+$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "denial_reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_context_id": {
      "type": "string",
      "pattern": "^execution-context:[A-Za-z0-9._:-]+$"
    },
    "tool_attestation_id": {
      "type": "string",
      "pattern": "^tool-attestation:[A-Za-z0-9._:-]+$"
    },
    "runtime_interlock_id": {
      "type": "string",
      "pattern": "^runtime-interlock:[A-Za-z0-9._:-]+$"
    },
    "data_egress_authorization_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^data-egress:[A-Za-z0-9._:-]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "allowed"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "execution_token"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "denied",
              "human_review_required"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "denial_reasons"
        ]
      }
    }
  ]
}
