{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/zeroshiki/schemas/runtime-trace-record.schema.json",
  "title": "Runtime Trace Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "trace_id",
    "agent_id",
    "grant_id",
    "receipt_id",
    "started_at",
    "completed_at",
    "recorder",
    "model_self_reported",
    "events",
    "final_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_type": {"const": "runtime_trace_record"},
    "trace_id": {
      "type": "string",
      "pattern": "^runtime-trace:[A-Za-z0-9._:-]+$"
    },
    "agent_id": {"type": "string", "minLength": 1},
    "grant_id": {
      "type": "string",
      "pattern": "^capability-grant:[A-Za-z0-9._:-]+$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^action-gate:[A-Za-z0-9._:-]+$"
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "recorder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorder_id", "runtime_enforced"],
      "properties": {
        "recorder_id": {"type": "string", "minLength": 1},
        "runtime_enforced": {"const": true}
      }
    },
    "model_self_reported": {"const": false},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "timestamp",
          "event_type",
          "action",
          "target",
          "outcome",
          "evidence_ref"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "timestamp": {"type": "string", "format": "date-time"},
          "event_type": {
            "type": "string",
            "enum": [
              "tool_call",
              "network_request",
              "file_write",
              "credential_use",
              "child_agent_create",
              "external_output",
              "process_exec"
            ]
          },
          "action": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "outcome": {
            "type": "string",
            "enum": ["succeeded", "blocked", "failed"]
          },
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "final_status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed"]
    }
  }
}
