{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://example.org/zeroshiki/schemas/runtime-trace-record.schema.json",
  "title": "Runtime Trace Record",
  "required": [
    "schema_version",
    "record_type",
    "trace_id",
    "agent_id",
    "authority_domain_id",
    "grant_id",
    "grant_epoch",
    "receipt_id",
    "execution_token_id",
    "data_egress_violation_observed",
    "tool_substitution_observed",
    "context_drift_observed",
    "data_egress_authorization_id",
    "runtime_interlock_id",
    "tool_attestation_id",
    "execution_context_id",
    "continuity_receipt_ids",
    "started_at",
    "completed_at",
    "recorder",
    "model_self_reported",
    "revocation_observed",
    "events",
    "final_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "record_type": {
      "const": "runtime_trace_record"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^runtime-trace:[A-Za-z0-9._:-]+$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_domain_id": {
      "type": "string",
      "pattern": "^authority-domain:[A-Za-z0-9._:-]+$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^capability-grant:[A-Za-z0-9._:-]+$"
    },
    "grant_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^action-gate:[A-Za-z0-9._:-]+$"
    },
    "execution_token_id": {
      "type": "string",
      "pattern": "^execution-token:[A-Za-z0-9._:-]+$"
    },
    "continuity_receipt_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^execution-continuity:[A-Za-z0-9._:-]+$"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorder_id",
        "runtime_enforced"
      ],
      "properties": {
        "recorder_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime_enforced": {
          "const": true
        }
      }
    },
    "model_self_reported": {
      "const": false
    },
    "revocation_observed": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "timestamp",
          "event_type",
          "action",
          "target",
          "outcome",
          "evidence_ref"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "tool_call",
              "network_request",
              "file_write",
              "credential_use",
              "child_agent_create",
              "external_output",
              "process_exec",
              "continuity_checkpoint",
              "revocation_observed",
              "execution_suspended"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "succeeded",
              "blocked",
              "failed"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "final_status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "failed",
        "zeroized"
      ]
    },
    "execution_context_id": {
      "type": "string",
      "pattern": "^execution-context:[A-Za-z0-9._:-]+$"
    },
    "tool_attestation_id": {
      "type": "string",
      "pattern": "^tool-attestation:[A-Za-z0-9._:-]+$"
    },
    "runtime_interlock_id": {
      "type": "string",
      "pattern": "^runtime-interlock:[A-Za-z0-9._:-]+$"
    },
    "data_egress_authorization_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^data-egress:[A-Za-z0-9._:-]+$"
    },
    "context_drift_observed": {
      "type": "boolean"
    },
    "tool_substitution_observed": {
      "type": "boolean"
    },
    "data_egress_violation_observed": {
      "type": "boolean"
    }
  }
}
