{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/zeroshiki/schemas/capability-grant.schema.json",
  "title": "Capability Grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "grant_id",
    "agent_id",
    "origin_ref",
    "issuer",
    "purpose",
    "capability",
    "constraints",
    "valid_from",
    "expires_at",
    "revocable",
    "ambient_authority",
    "delegation",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_type": {"const": "capability_grant"},
    "grant_id": {
      "type": "string",
      "pattern": "^capability-grant:[A-Za-z0-9._:-]+$"
    },
    "agent_id": {"type": "string", "minLength": 1},
    "origin_ref": {"type": "string", "minLength": 1},
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_type", "issuer_id"],
      "properties": {
        "issuer_type": {
          "type": "string",
          "enum": ["human", "authorized_service", "independent_authority"]
        },
        "issuer_id": {"type": "string", "minLength": 1}
      }
    },
    "purpose": {"type": "string", "minLength": 1},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "targets", "allowed_tools"],
      "properties": {
        "action_type": {"type": "string", "minLength": 1},
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_invocations", "network_destinations", "data_classes"],
      "properties": {
        "max_invocations": {"type": "integer", "minimum": 1},
        "network_destinations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "data_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revocable": {"const": true},
    "ambient_authority": {"const": false},
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegable", "self_expansion_allowed"],
      "properties": {
        "delegable": {"const": false},
        "self_expansion_allowed": {"const": false}
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "revoked", "expired", "consumed"]
    }
  }
}
