{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://example.org/zeroshiki/schemas/capability-grant.schema.json",
  "title": "Capability Grant",
  "required": [
    "schema_version",
    "record_type",
    "grant_id",
    "grant_kind",
    "agent_id",
    "authority_domain_id",
    "issued_revocation_epoch",
    "grant_epoch",
    "origin_ref",
    "issuer",
    "purpose",
    "maximum_risk_tier",
    "capability",
    "constraints",
    "valid_from",
    "expires_at",
    "revocable",
    "ambient_authority",
    "parent_grant_id",
    "delegation_receipt_id",
    "delegation",
    "renewal_policy",
    "revocation_channel",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "record_type": {
      "const": "capability_grant"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^capability-grant:[A-Za-z0-9._:-]+$"
    },
    "grant_kind": {
      "type": "string",
      "enum": [
        "root",
        "delegated"
      ]
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_domain_id": {
      "type": "string",
      "pattern": "^authority-domain:[A-Za-z0-9._:-]+$"
    },
    "issued_revocation_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "grant_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "origin_ref": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_type",
        "issuer_id"
      ],
      "properties": {
        "issuer_type": {
          "type": "string",
          "enum": [
            "human",
            "authorized_service",
            "independent_authority"
          ]
        },
        "issuer_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "maximum_risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type",
        "targets",
        "allowed_tools"
      ],
      "properties": {
        "action_type": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_invocations",
        "network_destinations",
        "data_classes"
      ],
      "properties": {
        "max_invocations": {
          "type": "integer",
          "minimum": 1
        },
        "network_destinations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revocable": {
      "const": true
    },
    "ambient_authority": {
      "const": false
    },
    "parent_grant_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^capability-grant:[A-Za-z0-9._:-]+$"
    },
    "delegation_receipt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^capability-delegation:[A-Za-z0-9._:-]+$"
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegable",
        "max_depth",
        "allowed_child_agents",
        "requires_independent_countersignature",
        "self_expansion_allowed"
      ],
      "properties": {
        "delegable": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "allowed_child_agents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires_independent_countersignature": {
          "const": true
        },
        "self_expansion_allowed": {
          "const": false
        }
      }
    },
    "renewal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renewable",
        "max_renewals",
        "max_extension_seconds",
        "automatic_renewal"
      ],
      "properties": {
        "renewable": {
          "type": "boolean"
        },
        "max_renewals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "max_extension_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "automatic_renewal": {
          "const": false
        }
      }
    },
    "revocation_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "propagation_required"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "pattern": "^revocation-channel:[A-Za-z0-9._:-]+$"
        },
        "propagation_required": {
          "const": true
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired",
        "consumed",
        "suspended"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "grant_kind": {
            "const": "root"
          }
        },
        "required": [
          "grant_kind"
        ]
      },
      "then": {
        "properties": {
          "parent_grant_id": {
            "const": null
          },
          "delegation_receipt_id": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "grant_kind": {
            "const": "delegated"
          }
        },
        "required": [
          "grant_kind"
        ]
      },
      "then": {
        "properties": {
          "parent_grant_id": {
            "type": "string",
            "pattern": "^capability-grant:[A-Za-z0-9._:-]+$"
          },
          "delegation_receipt_id": {
            "type": "string",
            "pattern": "^capability-delegation:[A-Za-z0-9._:-]+$"
          }
        }
      }
    }
  ]
}
